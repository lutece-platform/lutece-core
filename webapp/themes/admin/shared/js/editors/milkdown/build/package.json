{
  "name": "lutece-milkdown-bundle",
  "private": true,
  "description": "Builds milkdown.min.js and milkdown.min.css of the back office, see README.md",
  "dependencies": {
    "@milkdown/crepe": "7.22.2",
    "@milkdown/kit": "7.22.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --target=es2020 --loader:.svg=text --legal-comments=none --outfile=../milkdown.min.js"
  }
}
